{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.invalid/schemas/deployment-policy.schema.json",
  "title": "EventHorizon deployment policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "controller_contract_version",
    "trusted_repository",
    "trusted_remote",
    "approved_ref",
    "ci",
    "field_build",
    "protected_paths",
    "supported_compose_files",
    "result_schema_version",
    "evidence_index_schema_version",
    "ci_proof_schema_version",
    "remote_preflight_schema_version",
    "compose_config_schema_version",
    "deployment_manifest_schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "controller_contract_version": {
      "const": 1
    },
    "trusted_repository": {
      "const": "honeynet/EventHorizon"
    },
    "trusted_remote": {
      "const": "upstream"
    },
    "approved_ref": {
      "const": "refs/remotes/upstream/GSoC_2026"
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workflow_path",
        "event",
        "head_branch",
        "required_jobs"
      ],
      "properties": {
        "workflow_path": {
          "const": ".github/workflows/ci.yml"
        },
        "event": {
          "const": "push"
        },
        "head_branch": {
          "const": "GSoC_2026"
        },
        "required_jobs": {
          "type": "array",
          "prefixItems": [
            {
              "const": "build-unit"
            },
            {
              "const": "deployment-controller"
            },
            {
              "const": "shell-quality"
            },
            {
              "const": "configuration-policy"
            },
            {
              "const": "container-builds"
            },
            {
              "const": "deterministic-smoke"
            },
            {
              "const": "ci-contract"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      }
    },
    "field_build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "dockerfiles",
        "base_images",
        "compose_images",
        "go_toolchain",
        "go_module_mode"
      ],
      "properties": {
        "platform": {
          "const": "linux/amd64"
        },
        "dockerfiles": {
          "type": "array",
          "prefixItems": [
            {
              "const": "docker/tarpits/Dockerfile"
            },
            {
              "const": "docker/prometheus/Dockerfile"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "base_images": {
          "type": "array",
          "prefixItems": [
            {
              "const": "gcc:12.5.0-bookworm@sha256:01cfb27075399638ccdffa855970683ad298a3fad61012d7ab62523abbff5d20"
            },
            {
              "const": "golang:1.23.9-bookworm@sha256:0c9738aabadd34e99cf5263ae1337ad5330126c87a1fab4ffabec2284944c991"
            },
            {
              "const": "debian:bookworm-slim@sha256:63a496b5d3b99214b39f5ed70eb71a61e590a77979c79cbee4faf991f8c0783e"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        "compose_images": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prometheus",
            "grafana",
            "cadvisor"
          ],
          "properties": {
            "prometheus": {
              "const": "prom/prometheus:v3.5.0@sha256:8672a850efe2f9874702406c8318704edb363587f8c2ca88586b4c8fdb5cea24"
            },
            "grafana": {
              "const": "grafana/grafana-oss:12.1.0@sha256:11c2e6c7993917ea89292b942e3428f73907b2809d554154bfb8b4ceb2301cc8"
            },
            "cadvisor": {
              "const": "ghcr.io/google/cadvisor:v0.57.0@sha256:1742bab953d9d9ab166cba24604a9488efdff7d73dc6d18a087c09a1bcd6cb9d"
            }
          }
        },
        "go_toolchain": {
          "const": "1.23.9"
        },
        "go_module_mode": {
          "const": "readonly"
        }
      }
    },
    "protected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "supported_compose_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^docker-compose[.][A-Za-z0-9_-]+[.]yml$|^docker-compose[.]yml$"
      }
    },
    "result_schema_version": {
      "const": 1
    },
    "evidence_index_schema_version": {
      "const": 1
    },
    "ci_proof_schema_version": {
      "const": 1
    },
    "remote_preflight_schema_version": {
      "const": 2
    },
    "compose_config_schema_version": {
      "const": 1
    },
    "deployment_manifest_schema_version": {
      "const": 1
    }
  }
}
