{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.invalid/schemas/deployment-result.schema.json",
  "title": "EventHorizon deployment result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "operation",
    "target_state",
    "highest_state",
    "outcome",
    "exit_code",
    "started_utc",
    "finished_utc",
    "remote_mutation_occurred",
    "field_services_running",
    "checks",
    "evidence",
    "next_action"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^deploy-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,32}$"
    },
    "operation": {
      "enum": [
        "ci_validation",
        "vps_deployment"
      ]
    },
    "target_state": {
      "enum": [
        "CI_VALIDATED",
        "ENVIRONMENT_VALIDATED"
      ]
    },
    "highest_state": {
      "enum": [
        "DEPLOYMENT_CANDIDATE",
        "CI_VALIDATED",
        "ENVIRONMENT_VALIDATED",
        null
      ]
    },
    "outcome": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAIL",
        "INCONCLUSIVE",
        "ERROR",
        "CANCELLED"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        2,
        3,
        4,
        5,
        6,
        130
      ]
    },
    "started_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "finished_utc": {
      "$ref": "#/$defs/utcTimestamp"
    },
    "remote_mutation_occurred": {
      "type": "boolean"
    },
    "field_services_running": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "evidence": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "ci_validation"
          }
        }
      },
      "then": {
        "properties": {
          "target_state": {
            "const": "CI_VALIDATED"
          },
          "highest_state": {
            "enum": [
              "DEPLOYMENT_CANDIDATE",
              "CI_VALIDATED",
              null
            ]
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "operation"
        ],
        "properties": {
          "operation": {
            "const": "vps_deployment"
          }
        }
      },
      "then": {
        "properties": {
          "target_state": {
            "const": "ENVIRONMENT_VALIDATED"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "operation",
          "outcome"
        ],
        "properties": {
          "operation": {
            "const": "ci_validation"
          },
          "outcome": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "highest_state": {
            "const": "CI_VALIDATED"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "operation",
          "outcome"
        ],
        "properties": {
          "operation": {
            "const": "vps_deployment"
          },
          "outcome": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "highest_state": {
            "const": "ENVIRONMENT_VALIDATED"
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "outcome": {
              "const": "PASS"
            },
            "exit_code": {
              "const": 0
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "BLOCKED"
            },
            "exit_code": {
              "const": 2
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "FAIL"
            },
            "exit_code": {
              "const": 3
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "INCONCLUSIVE"
            },
            "exit_code": {
              "const": 4
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "ERROR"
            },
            "exit_code": {
              "const": 5
            }
          }
        },
        {
          "properties": {
            "outcome": {
              "const": "CANCELLED"
            },
            "exit_code": {
              "enum": [
                6,
                130
              ]
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "check_id",
        "phase",
        "status",
        "summary"
      ],
      "properties": {
        "check_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "phase": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "status": {
          "enum": [
            "PASS",
            "WARNING",
            "BLOCKER",
            "FAIL",
            "INCONCLUSIVE",
            "ERROR"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed": {
          "type": "string",
          "maxLength": 500
        },
        "required": {
          "type": "string",
          "maxLength": 500
        },
        "next_action": {
          "type": "string",
          "maxLength": 500
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          }
        }
      }
    }
  }
}
