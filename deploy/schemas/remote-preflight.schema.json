{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.invalid/schemas/remote-preflight.schema.json",
  "title": "EventHorizon remote preflight evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target_alias",
    "deployment_commit",
    "checked_utc",
    "starting_state",
    "managed_checkout_commit",
    "prior_evidence_commit",
    "interrupted_redeployment",
    "result",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "target_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "deployment_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "checked_utc": {
      "type": "string",
      "format": "date-time"
    },
    "starting_state": {
      "enum": [
        "INITIAL_DEPLOYMENT",
        "MANAGED_REDEPLOYMENT",
        "UNSUPPORTED"
      ]
    },
    "managed_checkout_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "prior_evidence_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "interrupted_redeployment": {
      "type": "boolean"
    },
    "result": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "summary"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "status": {
            "enum": [
              "PASS",
              "WARNING",
              "BLOCKER"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "starting_state": {
            "enum": [
              "INITIAL_DEPLOYMENT",
              "UNSUPPORTED"
            ]
          }
        },
        "required": [
          "starting_state"
        ]
      },
      "then": {
        "properties": {
          "managed_checkout_commit": {
            "const": null
          },
          "prior_evidence_commit": {
            "const": null
          },
          "interrupted_redeployment": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "starting_state": {
            "const": "MANAGED_REDEPLOYMENT"
          },
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "starting_state",
          "result"
        ]
      },
      "then": {
        "properties": {
          "managed_checkout_commit": {
            "type": "string"
          },
          "prior_evidence_commit": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        },
        "required": [
          "result"
        ]
      },
      "then": {
        "properties": {
          "starting_state": {
            "enum": [
              "INITIAL_DEPLOYMENT",
              "MANAGED_REDEPLOYMENT"
            ]
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "enum": [
                    "PASS",
                    "WARNING"
                  ]
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "status": {
                  "const": "BLOCKER"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    }
  ]
}
