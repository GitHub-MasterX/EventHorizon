{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.invalid/schemas/evidence-index.schema.json",
  "title": "EventHorizon deployment evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "generated_utc",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^deploy-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,32}$"
    },
    "generated_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "size_bytes",
        "sha256",
        "collection_status",
        "reason"
      ],
      "properties": {
        "filename": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "not": {
            "const": "evidence-index.json"
          }
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "collection_status": {
          "enum": [
            "COLLECTED",
            "MISSING",
            "FAILED",
            "NOT_APPLICABLE"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "collection_status": {
                "const": "COLLECTED"
              }
            }
          },
          "then": {
            "properties": {
              "size_bytes": {
                "type": "integer"
              },
              "sha256": {
                "type": "string"
              },
              "reason": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "size_bytes": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
