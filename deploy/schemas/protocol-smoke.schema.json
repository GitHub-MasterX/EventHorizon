{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.invalid/schemas/protocol-smoke.schema.json",
  "title": "EventHorizon deterministic deployment smoke evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target_alias",
    "deployment_commit",
    "started_utc",
    "finished_utc",
    "result",
    "reason_code",
    "client_implementation",
    "baseline",
    "final",
    "clients",
    "protocols",
    "cleanup"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": {
      "type": "string",
      "pattern": "^deploy-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,32}$"
    },
    "target_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "deployment_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "started_utc": { "type": "string", "format": "date-time" },
    "finished_utc": { "type": "string", "format": "date-time" },
    "result": {
      "enum": ["PASS", "BLOCKED", "FAIL", "INCONCLUSIVE", "ERROR"]
    },
    "reason_code": {
      "enum": [
        "SMOKE_PASSED",
        "CLEAN_BASELINE_UNAVAILABLE",
        "CLIENT_MALFUNCTION",
        "METRIC_EVIDENCE_INSUFFICIENT",
        "ACCEPTANCE_CHECK_FAILED",
        "REMOTE_TRANSPORT_MALFUNCTION",
        "REMOTE_EVIDENCE_MALFORMED",
        "CLEANUP_UNPROVEN"
      ]
    },
    "client_implementation": { "const": "PYTHON_STDLIB" },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/snapshot" }
      ]
    },
    "final": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/snapshot" }
      ]
    },
    "clients": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/client" },
            { "properties": { "protocol": { "const": "telnet" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/client" },
            { "properties": { "protocol": { "const": "mqtt" } } }
          ]
        }
      ],
      "items": false
    },
    "protocols": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/protocolResult" },
            { "properties": { "protocol": { "const": "telnet" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/protocolResult" },
            { "properties": { "protocol": { "const": "mqtt" } } }
          ]
        }
      ],
      "items": false
    },
    "cleanup": { "$ref": "#/$defs/cleanup" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "result": { "const": "PASS" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "reason_code": { "const": "SMOKE_PASSED" },
          "baseline": { "$ref": "#/$defs/snapshot" },
          "final": { "$ref": "#/$defs/snapshot" },
          "clients": {
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "properties": { "result": { "const": "PASS" } }
            }
          },
          "protocols": {
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "properties": {
                "result": { "const": "PASS" },
                "deltas": {
                  "properties": {
                    "connections": { "const": 1 },
                    "completed_sessions": { "const": 1 },
                    "depth_total": { "const": 1 },
                    "depth_2": { "const": 1 },
                    "duration_count": { "const": 1 },
                    "duration_inf": { "const": 1 },
                    "application_bytes_received": { "minimum": 1 },
                    "application_bytes_sent": { "minimum": 1 },
                    "malformed_messages": { "const": 0 },
                    "restarts": { "const": 0 }
                  }
                },
                "checks": {
                  "properties": {
                    "exact_connection": { "const": true },
                    "exact_completion": { "const": true },
                    "active_settled": { "const": true },
                    "exact_depth_total": { "const": true },
                    "exact_depth_2": { "const": true },
                    "exact_duration_count": { "const": true },
                    "exact_duration_inf": { "const": true },
                    "positive_bytes_received": { "const": true },
                    "positive_bytes_sent": { "const": true },
                    "malformed_unchanged": { "const": true },
                    "restart_unchanged": { "const": true },
                    "oom_not_observed": { "const": true },
                    "lifecycle_reconciled": { "const": true },
                    "depth_reconciled": { "const": true },
                    "duration_reconciled": { "const": true }
                  }
                }
              }
            }
          },
          "cleanup": {
            "properties": {
              "attempted": { "const": false },
              "succeeded": { "const": null }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "protocol": { "enum": ["telnet", "mqtt"] },
    "nonNegativeInteger": { "type": "integer", "minimum": 0 },
    "protocolSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "connections",
        "completed_sessions",
        "active_sessions",
        "depth_0",
        "depth_1",
        "depth_2",
        "depth_3",
        "duration_count",
        "duration_inf",
        "application_bytes_received",
        "application_bytes_sent",
        "restart_count",
        "oom_killed",
        "image_id_verified"
      ],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "connections": { "$ref": "#/$defs/nonNegativeInteger" },
        "completed_sessions": { "$ref": "#/$defs/nonNegativeInteger" },
        "active_sessions": { "$ref": "#/$defs/nonNegativeInteger" },
        "depth_0": { "$ref": "#/$defs/nonNegativeInteger" },
        "depth_1": { "$ref": "#/$defs/nonNegativeInteger" },
        "depth_2": { "$ref": "#/$defs/nonNegativeInteger" },
        "depth_3": { "$ref": "#/$defs/nonNegativeInteger" },
        "duration_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "duration_inf": { "$ref": "#/$defs/nonNegativeInteger" },
        "application_bytes_received": { "$ref": "#/$defs/nonNegativeInteger" },
        "application_bytes_sent": { "$ref": "#/$defs/nonNegativeInteger" },
        "restart_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "oom_killed": { "type": "boolean" },
        "image_id_verified": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_utc",
        "scrape_utc",
        "malformed_messages",
        "protocols"
      ],
      "properties": {
        "captured_utc": { "type": "string", "format": "date-time" },
        "scrape_utc": { "type": "string", "format": "date-time" },
        "malformed_messages": { "$ref": "#/$defs/nonNegativeInteger" },
        "protocols": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                { "$ref": "#/$defs/protocolSnapshot" },
                { "properties": { "protocol": { "const": "telnet" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/$defs/protocolSnapshot" },
                { "properties": { "protocol": { "const": "mqtt" } } }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "result", "bytes_written", "bytes_read"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "result": { "enum": ["PASS", "ERROR"] },
        "bytes_written": { "$ref": "#/$defs/nonNegativeInteger" },
        "bytes_read": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "deltas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connections",
        "completed_sessions",
        "depth_total",
        "depth_2",
        "duration_count",
        "duration_inf",
        "application_bytes_received",
        "application_bytes_sent",
        "malformed_messages",
        "restarts"
      ],
      "properties": {
        "connections": { "type": "integer" },
        "completed_sessions": { "type": "integer" },
        "depth_total": { "type": "integer" },
        "depth_2": { "type": "integer" },
        "duration_count": { "type": "integer" },
        "duration_inf": { "type": "integer" },
        "application_bytes_received": { "type": "integer" },
        "application_bytes_sent": { "type": "integer" },
        "malformed_messages": { "type": "integer" },
        "restarts": { "type": "integer" }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_connection",
        "exact_completion",
        "active_settled",
        "exact_depth_total",
        "exact_depth_2",
        "exact_duration_count",
        "exact_duration_inf",
        "positive_bytes_received",
        "positive_bytes_sent",
        "malformed_unchanged",
        "restart_unchanged",
        "oom_not_observed",
        "lifecycle_reconciled",
        "depth_reconciled",
        "duration_reconciled"
      ],
      "properties": {
        "exact_connection": { "type": "boolean" },
        "exact_completion": { "type": "boolean" },
        "active_settled": { "type": "boolean" },
        "exact_depth_total": { "type": "boolean" },
        "exact_depth_2": { "type": "boolean" },
        "exact_duration_count": { "type": "boolean" },
        "exact_duration_inf": { "type": "boolean" },
        "positive_bytes_received": { "type": "boolean" },
        "positive_bytes_sent": { "type": "boolean" },
        "malformed_unchanged": { "type": "boolean" },
        "restart_unchanged": { "type": "boolean" },
        "oom_not_observed": { "type": "boolean" },
        "lifecycle_reconciled": { "type": "boolean" },
        "depth_reconciled": { "type": "boolean" },
        "duration_reconciled": { "type": "boolean" }
      }
    },
    "protocolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "result", "deltas", "checks"],
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "result": { "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
        "deltas": { "$ref": "#/$defs/deltas" },
        "checks": { "$ref": "#/$defs/checks" }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "succeeded"],
      "properties": {
        "attempted": { "type": "boolean" },
        "succeeded": { "type": ["boolean", "null"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "attempted": { "const": false } },
            "required": ["attempted"]
          },
          "then": { "properties": { "succeeded": { "const": null } } }
        },
        {
          "if": {
            "properties": { "attempted": { "const": true } },
            "required": ["attempted"]
          },
          "then": { "properties": { "succeeded": { "type": "boolean" } } }
        }
      ]
    }
  }
}
