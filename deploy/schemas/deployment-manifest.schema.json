{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eventhorizon.invalid/schemas/deployment-manifest.schema.json",
  "title": "EventHorizon exact-source deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "target_alias",
    "deployment_commit",
    "repository_commit",
    "compose_project_name",
    "trusted_repository",
    "approved_branch",
    "starting_state",
    "deployed_utc",
    "platform",
    "head_verified",
    "worktree_clean",
    "docker_version",
    "compose_version",
    "rendered_compose_sha256",
    "pinned_inputs",
    "service_image_ids",
    "volume_names",
    "prior_deployment",
    "cleanup",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^deploy-[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6,32}$"
    },
    "target_alias": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "deployment_commit": {
      "$ref": "#/$defs/commit"
    },
    "repository_commit": {
      "$ref": "#/$defs/commit"
    },
    "compose_project_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
    },
    "trusted_repository": {
      "const": "honeynet/EventHorizon"
    },
    "approved_branch": {
      "const": "GSoC_2026"
    },
    "starting_state": {
      "enum": [
        "INITIAL_DEPLOYMENT",
        "MANAGED_REDEPLOYMENT"
      ]
    },
    "deployed_utc": {
      "$ref": "#/$defs/timestamp"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "head_verified": {
      "const": true
    },
    "worktree_clean": {
      "const": true
    },
    "docker_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "compose_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "rendered_compose_sha256": {
      "$ref": "#/$defs/digest"
    },
    "pinned_inputs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9./_-]+:[A-Za-z0-9._-]+@sha256:[0-9a-f]{64}$",
        "maxLength": 300
      }
    },
    "service_image_ids": {
      "$ref": "#/$defs/serviceImageIdsPartial"
    },
    "volume_names": {
      "$ref": "#/$defs/volumeNames"
    },
    "prior_deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "service_image_ids",
        "volume_names"
      ],
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40}$"
        },
        "service_image_ids": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "cadvisor",
              "grafana",
              "mqtt_pit",
              "prometheus",
              "prometheus-exporter",
              "telnet_pit"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/imageId"
          }
        },
        "volume_names": {
          "$ref": "#/$defs/volumeNames"
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "succeeded"
      ],
      "properties": {
        "attempted": {
          "type": "boolean"
        },
        "succeeded": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "result": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAIL",
        "INCONCLUSIVE",
        "ERROR"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "service_image_ids": {
            "$ref": "#/$defs/serviceImageIds"
          },
          "cleanup": {
            "properties": {
              "attempted": {
                "const": false
              },
              "succeeded": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cleanup": {
            "properties": {
              "attempted": {
                "const": false
              }
            },
            "required": [
              "attempted"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "cleanup": {
            "properties": {
              "succeeded": {
                "const": null
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "cleanup": {
            "properties": {
              "succeeded": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "imageId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "serviceImageIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadvisor",
        "grafana",
        "mqtt_pit",
        "prometheus",
        "prometheus-exporter",
        "telnet_pit"
      ],
      "properties": {
        "cadvisor": {
          "$ref": "#/$defs/imageId"
        },
        "grafana": {
          "$ref": "#/$defs/imageId"
        },
        "mqtt_pit": {
          "$ref": "#/$defs/imageId"
        },
        "prometheus": {
          "$ref": "#/$defs/imageId"
        },
        "prometheus-exporter": {
          "$ref": "#/$defs/imageId"
        },
        "telnet_pit": {
          "$ref": "#/$defs/imageId"
        }
      }
    },
    "serviceImageIdsPartial": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "cadvisor",
          "grafana",
          "mqtt_pit",
          "prometheus",
          "prometheus-exporter",
          "telnet_pit"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/imageId"
      }
    },
    "volumeNames": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    }
  }
}
