# Copy to deploy/vps-field.env, replace the examples, and run chmod 0600.
# This is strict KEY=VALUE data, not shell syntax. Never put key contents,
# credentials, deployment commits, trust policy, or observation settings here.
TARGET_ALIAS=field-host
VPS_HOST=vps.example.invalid
VPS_USER=operator
VPS_SSH_PORT=22
VPS_SSH_KEY=/home/operator/.ssh/eventhorizon_field
VPS_DEPLOY_DIR=/srv/eventhorizon-field
VPS_PROJECT_NAME=eventhorizon-field
ADMIN_SOURCE_CIDR=203.0.113.9/32

# Empty memory means no configured limit. A non-empty value needs a unit such
# as 256m or 1g.
FIELD_TARPIT_CPU_LIMIT=0.50
FIELD_TARPIT_MEMORY_LIMIT=
