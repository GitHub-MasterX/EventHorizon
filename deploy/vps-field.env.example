# Copy this file to deploy/vps-field.env and fill every required value.
# Never store credentials, private key contents, or provider tokens here.
VPS_HOST=
VPS_USER=
VPS_SSH_PORT=22
VPS_SSH_KEY=
VPS_DEPLOY_DIR='~/eventhorizon-field'
VPS_PROJECT_NAME=eventhorizon-field
REPOSITORY_URL=
DEPLOY_BRANCH=GSoC_2026
DEPLOY_COMMIT=
ADMIN_SOURCE_CIDR=
FIELD_DURATION_HOURS=72
SNAPSHOT_INTERVAL_HOURS=6

# CPU is always supported by the current field overlay. Set a memory limit only
# after the remote preflight confirms a working cgroup-v2 memory controller.
FIELD_TARPIT_CPU_LIMIT=0.50
FIELD_TARPIT_MEMORY_LIMIT=
