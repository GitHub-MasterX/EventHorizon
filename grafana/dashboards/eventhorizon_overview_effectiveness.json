      "id": 9,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "(sum by (protocol) (rate(eventhorizon_session_duration_ms_sum[$__rate_interval])) / sum by (protocol) (rate(eventhorizon_session_duration_ms_count[$__rate_interval]))) / 1000", "instant": true, "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Average Session Duration",
      "type": "stat"
