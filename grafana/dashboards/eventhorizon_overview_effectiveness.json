      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (protocol, le) (rate(eventhorizon_session_duration_ms_bucket[$__rate_interval]))", "legendFormat": "{{protocol}} {{le}}ms", "refId": "A"}],
      "title": "Duration Distribution",
