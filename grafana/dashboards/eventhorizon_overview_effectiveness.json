      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"content": "EventHorizon's essential Prometheus views in one place: current traffic, retained attacker time, completed-session duration, protocol activity, and measurement reliability.\n\nCompleted-session and lifecycle-reconciliation panels currently cover Telnet and MQTT. Reliability outcomes can describe normal peer behavior as well as faults, so they should be interpreted with their bounded reason labels.\n\nAll dashboard timestamps are displayed in UTC (UTC+00:00).", "mode": "markdown"},
      "title": "Dashboard Purpose & Interpretation",
      "type": "text"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 2, "panels": [], "title": "1. Effectiveness", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 6},
      "id": 3,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(current_connected_clients)", "instant": true, "legendFormat": "active", "refId": "A"}],
      "title": "Active Clients",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 6},
      "id": 4,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(total_connects[$__rate_interval]))", "instant": true, "legendFormat": "connections/s", "refId": "A"}],
      "title": "Connection Rate",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 6},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(increase(eventhorizon_completed_sessions_total[$__rate_interval]))", "instant": true, "legendFormat": "completed", "refId": "A"}],
      "title": "Completed Sessions",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
