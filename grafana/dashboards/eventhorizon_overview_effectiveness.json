      "targets": [{"expr": "sum(total_trapped_time_ms)", "instant": true, "legendFormat": "trapped", "refId": "A"}],
      "title": "Total Trapped Time",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 11},
      "id": 7,
      "options": {"barWidth": 0.8, "groupWidth": 0.7, "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 100},
      "pluginVersion": "12.4.1",
      "targets": [{"expr": "sum by (protocol, action) (increase(eventhorizon_protocol_actions_total[$__rate_interval]))", "legendFormat": "{{protocol}} / {{action}}", "refId": "A"}],
      "title": "Protocol Activity",
      "type": "barchart"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 19}, "id": 8, "panels": [], "title": "2. Trapping Duration", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
