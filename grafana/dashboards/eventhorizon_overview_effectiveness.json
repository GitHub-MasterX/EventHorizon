      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 20},
      "id": 12,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum by (protocol) (rate(eventhorizon_early_disconnect_total[$__rate_interval])) / sum by (protocol) (rate(eventhorizon_completed_sessions_total[$__rate_interval]))", "instant": true, "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Early Disconnect Ratio",
      "type": "stat"
