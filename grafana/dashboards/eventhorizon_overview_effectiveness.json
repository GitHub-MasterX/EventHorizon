      "title": "P50 Session Duration",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 20},
      "id": 11,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (protocol, le) (rate(eventhorizon_session_duration_ms_bucket[$__rate_interval]))) / 1000", "instant": true, "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "P95 Session Duration",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Provisional: a completed Telnet/MQTT session with zero protocol-specific meaningful client actions.",
