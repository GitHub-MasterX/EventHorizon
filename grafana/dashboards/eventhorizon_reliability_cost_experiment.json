  "panels": [
    {
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"content": "An experimental view that keeps measurement reliability, Defender Cost, and the future baseline-vs-modified evaluation separate. Lifecycle and application byte accounting are limited to Telnet and MQTT.\n\nThe Defender Cost row requires the optional cAdvisor cost overlay for container CPU and network data. Application bytes come from successful tarpit socket I/O and are not interchangeable with container-interface traffic. The memory panel is intentionally withheld on the current validation host because its cgroup-v2 memory controller is disabled and both cAdvisor and Docker report zero-byte memory values.\n\nAll dashboard timestamps are displayed in UTC (UTC+00:00).", "mode": "markdown"},
      "title": "Dashboard Purpose & Interpretation",
      "type": "text"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 2, "panels": [], "title": "Measurement Reliability", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Scoped to Telnet/MQTT. total_connects is the canonical connection-start counter.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 3,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {"expr": "sum(increase(total_connects{server=~\"Telnet|MQTT\"}[$__rate_interval]))", "legendFormat": "connections", "refId": "A"},
        {"expr": "sum(increase(eventhorizon_completed_sessions_total{protocol=~\"telnet|mqtt\"}[$__rate_interval]))", "legendFormat": "completions", "refId": "B"}
      ],
      "title": "Connections vs Completions",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Interpret near zero only after Telnet/MQTT sessions settle.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 4,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum(increase(total_connects{server=~\"Telnet|MQTT\"}[$__rate_interval])) - sum(increase(eventhorizon_completed_sessions_total{protocol=~\"telnet|mqtt\"}[$__rate_interval]))", "legendFormat": "gap", "refId": "A"}],
      "title": "Settled Lifecycle Gap",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 14},
      "id": 5,
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(current_connected_clients{server=~\"Telnet|MQTT\"})", "instant": true, "legendFormat": "active", "refId": "A"}],
      "title": "Active Clients",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 14},
      "id": 6,
      "options": {"barWidth": 0.8, "groupWidth": 0.7, "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 80},
      "pluginVersion": "12.4.1",
      "targets": [{"expr": "sum by (reason) (increase(eventhorizon_exporter_malformed_messages_total[$__rate_interval]))", "legendFormat": "{{reason}}", "refId": "A"}],
      "title": "Exporter Malformed Messages",
      "type": "barchart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Peer reset, close, timeout, or invalid packet can be normal scanner/client behavior. These are outcomes, not automatically system faults.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 14},
      "id": 7,
      "options": {"barWidth": 0.8, "groupWidth": 0.7, "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "single", "sort": "none"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 80},
      "pluginVersion": "12.4.1",
      "targets": [
        {"expr": "sum by (protocol, reason) (increase(eventhorizon_read_errors_total[$__rate_interval]))", "legendFormat": "read {{protocol}} / {{reason}}", "refId": "A"},
        {"expr": "sum by (protocol, reason) (increase(eventhorizon_write_errors_total[$__rate_interval]))", "legendFormat": "write {{protocol}} / {{reason}}", "refId": "B"}
      ],
      "title": "Runtime I/O Outcomes",
      "type": "barchart"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "id": 8, "panels": [], "title": "Defender Cost", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "CPU time consumed by the Telnet and MQTT tarpit containers, derived from cumulative cAdvisor CPU seconds. The value is percent of one CPU core, not normalized by machine cores or limits. This is defender resource usage, not attacker engagement. Requires the optional cost overlay.",
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "id": 9,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (container_label_com_docker_compose_project, container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"eventhorizon(-field)?\",container_label_com_docker_compose_service=~\"telnet_pit|mqtt_pit\",cpu=\"total\"}[$__rate_interval])) * 100", "legendFormat": "{{container_label_com_docker_compose_project}} / {{container_label_com_docker_compose_service}}", "refId": "A"}],
      "title": "Tarpit CPU Usage (% of One Core)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Bytes per second successfully returned by Telnet/MQTT client-facing reads. Includes protocol framing, excludes failed or zero-byte reads and internal telemetry, and is not packet-level traffic.",
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "id": 10,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (protocol) (rate(eventhorizon_bytes_received_total{protocol=~\"telnet|mqtt\"}[$__rate_interval]))", "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Application Bytes Received",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Bytes per second successfully returned by Telnet/MQTT client-facing writes. Includes protocol framing, counts partial writes by their actual result, and excludes failed or zero-byte writes and internal telemetry.",
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 31},
      "id": 11,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (protocol) (rate(eventhorizon_bytes_sent_total{protocol=~\"telnet|mqtt\"}[$__rate_interval]))", "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Application Bytes Sent",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Receive/transmit rates from each Telnet/MQTT container interface as observed by cAdvisor. Values include protocol, transport, and network overhead and therefore differ from EventHorizon application byte counters. Requires the optional cost overlay.",
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 31},
      "id": 12,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [
        {"expr": "sum by (container_label_com_docker_compose_project, container_label_com_docker_compose_service, interface) (rate(container_network_receive_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"eventhorizon(-field)?\",container_label_com_docker_compose_service=~\"telnet_pit|mqtt_pit\"}[$__rate_interval]))", "legendFormat": "RX {{container_label_com_docker_compose_project}} / {{container_label_com_docker_compose_service}} / {{interface}}", "refId": "A"},
        {"expr": "sum by (container_label_com_docker_compose_project, container_label_com_docker_compose_service, interface) (rate(container_network_transmit_bytes_total{job=\"cadvisor\",container_label_com_docker_compose_project=~\"eventhorizon(-field)?\",container_label_com_docker_compose_service=~\"telnet_pit|mqtt_pit\"}[$__rate_interval]))", "legendFormat": "TX {{container_label_com_docker_compose_project}} / {{container_label_com_docker_compose_service}} / {{interface}}", "refId": "B"}
      ],
      "title": "Container Network RX/TX",
      "type": "timeseries"
    },
