  "panels": [
    {
      "gridPos": {"h": 5, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "options": {"content": "Bounded final Telnet and MQTT session classification. Level 0 is no meaningful progression; level 1 is incomplete Telnet input or MQTT CONNECT only; level 2 is one complete Telnet line or one MQTT application operation; level 3 is continued interaction. The levels are ordinal categories, not a weighted score. No session ID, source IP, command, topic, payload, credential, or client ID is a metric label.\n\nAll dashboard timestamps and generated validation links use UTC (UTC+00:00).", "mode": "markdown"},
      "title": "Dashboard Purpose & Interpretation",
      "type": "text"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5}, "id": 2, "panels": [], "title": "Completed Session Interaction Depth", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Purpose: show completed-session depth changes over time. Interpret higher levels as more protocol progression, not greater attacker sophistication. Limitation: values are scrape-window increases and levels are ordinal.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (protocol, depth_level) (increase(eventhorizon_session_interaction_depth_total[$__rate_interval]))", "legendFormat": "{{protocol}} / level {{depth_level}}", "refId": "A"}],
      "title": "Completed Sessions by Interaction Depth",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Purpose: compare the selected UTC window's final depth distribution. Interpret each bar as a completed-session count. Limitation: sessions active at either window boundary are not a closed cohort.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 4,
      "options": {"displayMode": "gradient", "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "orientation": "horizontal", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showUnfilled": true},
      "targets": [{"expr": "sum by (protocol, depth_level) (increase(eventhorizon_session_interaction_depth_total[$__range]))", "instant": true, "legendFormat": "{{protocol}} / level {{depth_level}}", "refId": "A"}],
      "title": "Interaction Depth Distribution by Protocol",
      "type": "bargauge"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Purpose: show the fraction of completed sessions with no meaningful progression. During compatibility validation this must equal the early-disconnect ratio. Limitation: sparse completion counts make ratios unstable.",
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 5,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (protocol) (rate(eventhorizon_session_interaction_depth_total{depth_level=\"0\"}[$__rate_interval])) / sum by (protocol) (rate(eventhorizon_session_interaction_depth_total[$__rate_interval]))", "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Zero-Depth Session Ratio",
      "type": "timeseries"
    },
    {"collapsed": false, "gridPos": {"h": 1, "w": 24, "x": 0, "y": 22}, "id": 6, "panels": [], "title": "Actions and Reconciliation", "type": "row"},
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Purpose: compare bounded client-originated actions with completions. Interpretation: operational activity per completion, not per-session depth. Limitation: aggregate action totals can be skewed by a few long sessions.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 23},
      "id": 7,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (protocol) (increase(eventhorizon_protocol_actions_total{protocol=~\"telnet|mqtt\",action=~\"read|mqtt_connect|mqtt_publish|mqtt_subscribe|mqtt_unsubscribe\"}[$__rate_interval])) / sum by (protocol) (increase(eventhorizon_completed_sessions_total{protocol=~\"telnet|mqtt\"}[$__rate_interval]))", "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Meaningful Actions per Completion",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Purpose: expose the bounded protocol action vocabulary. Interpretation depends on action type; server writes are work signals, not client depth. Limitation: this is aggregate action telemetry.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 23},
      "id": 8,
      "options": {"barWidth": 0.8, "groupWidth": 0.7, "legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}, "xTickLabelRotation": 0, "xTickLabelSpacing": 100},
      "pluginVersion": "12.4.1",
      "targets": [{"expr": "sum by (protocol, action) (increase(eventhorizon_protocol_actions_total[$__rate_interval]))", "legendFormat": "{{protocol}} / {{action}}", "refId": "A"}],
      "title": "Protocol Actions by Type",
      "type": "barchart"
    },
    {
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "description": "Purpose: verify one final depth classification per completed Telnet/MQTT session. Expected value is exactly zero. Limitation: use a selected window that includes complete scrapes around both boundaries.",
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 31},
      "id": 9,
      "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "none"}},
      "targets": [{"expr": "sum by (protocol) (increase(eventhorizon_completed_sessions_total{protocol=~\"telnet|mqtt\"}[$__rate_interval])) - sum by (protocol) (increase(eventhorizon_session_interaction_depth_total[$__rate_interval]))", "legendFormat": "{{protocol}}", "refId": "A"}],
      "title": "Depth Reconciliation Gap",
      "type": "timeseries"
    }
  ],
